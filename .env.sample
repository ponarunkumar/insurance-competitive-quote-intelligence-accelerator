# ============================================================================
# Insurance Competitive Quote Intelligence — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to source control
# ============================================================================

# Azure Subscription & Region
AZURE_ENV_NAME=dev
AZURE_LOCATION=swedencentral
AZURE_SUBSCRIPTION_ID=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_PRIMARY_DEPLOYMENT=gpt-4o
AZURE_OPENAI_SECONDARY_DEPLOYMENT=gpt-4o-mini

# Azure AI Search
AI_SEARCH_ENDPOINT=
AI_SEARCH_INDEX_QUOTES=competitor-quotes
AI_SEARCH_INDEX_MANUALS=underwriting-manuals
AI_SEARCH_INDEX_APPETITE=appetite-guides

# Azure AI Speech
SPEECH_KEY=
SPEECH_REGION=swedencentral
SPEECH_DEFAULT_LANGUAGE=en-GB
SPEECH_TTS_VOICE=en-GB-SoniaNeural
SPEECH_CUSTOM_ENDPOINT_ID=

# Azure Document Intelligence
DOC_INTELLIGENCE_ENDPOINT=

# Azure AI Content Understanding
CONTENT_UNDERSTANDING_ENDPOINT=

# Azure AI Language
AI_LANGUAGE_ENDPOINT=

# Azure Communication Services
ACS_CONNECTION_STRING=
ACS_CALLBACK_ENDPOINT=

# Azure SQL (Operational Data Store)
AZURE_SQL_CONNECTION_STRING=
SQL_ADMIN_LOGIN=
SQL_ADMIN_PASSWORD=

# Azure Cosmos DB
COSMOS_ENDPOINT=
COSMOS_DATABASE=quote-intelligence

# Microsoft Fabric
FABRIC_SQL_ENDPOINT=

# API Management (AI Gateway)
APIM_GATEWAY_URL=
APIM_SUBSCRIPTION_KEY=
APIM_PUBLISHER_EMAIL=

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Agent Configuration
GUARDRAIL_BAND_PERCENT=10
MAX_COMPETITOR_SOURCES=10
COMPETITOR_TIMEOUT_SECONDS=30
HITL_APPROVAL_REQUIRED=true

# Foundry Agent Service
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_ID=

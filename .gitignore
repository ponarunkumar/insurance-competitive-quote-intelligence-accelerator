# ============================================================================
# Insurance Competitive Quote Intelligence Accelerator — .gitignore
# ============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/

# ---- Environment & Secrets (NEVER commit) ----
.env
.env.*
!.env.sample
*.pem
*.key
*.pfx

# ---- Azure ----
.azure/
*.azd.env

# ---- Terraform (if used alongside Bicep) ----
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# ---- IDE & Editors ----
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Test & Coverage ----
htmlcov/
.coverage
.coverage.*
.pytest_cache/
*.cover
.nox/
.tox/
nosetests.xml
coverage.xml
junit.xml

# ---- Docker ----
docker-compose.override.yml

# ---- Logs ----
*.log
logs/

# ---- Node (if front-end added later) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Jupyter Notebooks ----
.ipynb_checkpoints/

# ---- Data (large files — use sample data only in repo) ----
data/raw/
data/exports/
*.csv
*.parquet
!data/sample_*
!data/seed_sql.sql

